{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "ES2024.Promise"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noImplicitOverride": false,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": ["*.ts", "cases/*.ts", "ruled/*.ts"]
}
